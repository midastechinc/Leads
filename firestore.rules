rules_version = '2';

// Lead Tracker (midas-leads-a8b13) Firestore rules.
//
// Only the accounts listed in allowedEmails() can read or write anything.
// Signing in with any other account (for example one created through open
// email/password sign-up) gets "permission denied" everywhere.
//
// To add or remove a person: edit allowedEmails() below AND the backend's
// ALLOWED_EMAILS (Railway variable, or the default in
// supabase/functions/extract-contacts/index.ts), then deploy the rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowedEmails() {
      return [
        'ali@midastech.ca',
        'ambreen@midastech.ca',
        'scout@midastech.ca',
        'hjaffar2014@gmail.com',
        'hannahjaffar2010@gmail.com'
      ];
    }

    // None of the current accounts has a verified email (they were all created
    // with email/password and never sent a verification link), so requiring
    // email_verified today would lock everyone out. Exact-address matching is
    // safe because Firebase allows only one account per email address and all
    // of these addresses already have accounts. Once everyone has verified,
    // add:  && request.auth.token.email_verified == true
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() in allowedEmails();
    }

    function isAdmin() {
      return isAllowed()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // The page identifies a rep by the display string `currentUser`, which is
    // users/{uid}.name, or the sign-in email when the profile has no name
    // (loadCurrentUserProfile in index.html). A lead belongs to a rep when
    // lead.assignedTo equals that string; "" (or no field) means unassigned.
    function myRepName() {
      return myProfile().get('name', '') != '' ? myProfile().name : request.auth.token.email;
    }

    // Mirrors isLeadVisibleToCurrentUser / canCurrentUserManageLeadAssignment:
    // admins see everything; a rep sees unassigned leads and their own.
    function canAccessLeadData(data) {
      return isAdmin()
        || (isAllowed() && data.get('assignedTo', '') in ['', myRepName()]);
    }
    function canAccessLeadId(leadId) {
      return isAdmin()
        || (isAllowed()
            && exists(/databases/$(database)/documents/leads/$(leadId))
            && canAccessLeadData(get(/databases/$(database)/documents/leads/$(leadId)).data));
    }

    // ── User profiles ───────────────────────────────────────────────
    // Everyone allowed can see the team list (used for rep assignment).
    // A person may create their own profile only as a "rep" (auto-create on
    // first sign-in) and edit their own profile without changing their role,
    // name or email (the name is what leads are assigned to, so letting a rep
    // rename themselves to a colleague's name would hand them that rep's leads).
    // Only admins can create other users' profiles, change roles or delete.
    match /users/{uid} {
      allow read: if isAllowed();
      allow create: if isAdmin()
        || (isAllowed() && request.auth.uid == uid && request.resource.data.role == 'rep');
      allow update: if isAdmin()
        || (isAllowed() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('name', '') == resource.data.get('name', '')
            && request.resource.data.get('email', '') == resource.data.get('email', ''));
      allow delete: if isAdmin();
    }

    // First-admin bootstrap marker. Admins already exist, so only an admin
    // may touch it (this stops a non-admin from "claiming" admin).
    match /appMeta/{docId} {
      allow read: if isAllowed();
      allow write: if isAdmin();
    }

    // ── CRM data used by index.html ─────────────────────────────────
    // Leads: admins do anything. Reps read/update only unassigned leads or
    // leads assigned to them; they may hand such a lead to another rep (the
    // page allows this). Reps may create leads (manual add, screenshot reader,
    // company research). Only admins delete (deleteImportBatch, clearAllLeads,
    // archiveAndDeleteLeads are admin-only in the page).
    match /leads/{leadId} {
      allow get: if canAccessLeadData(resource.data);
      // Queries: a rep's query must itself filter on assignedTo ('' or their
      // own name), which is exactly what bindLeadListener() asks for.
      allow list: if isAdmin()
        || (isAllowed() && resource.data.assignedTo in ['', myRepName()]);
      allow create: if isAllowed();
      allow update: if canAccessLeadData(resource.data);
      allow delete: if isAdmin();
    }
    // Activities belong to a lead (activity.leadId). Reps read and add them
    // only for leads they can access; edits and deletes are admin-only.
    match /activities/{activityId} {
      allow read: if isAdmin()
        || (isAllowed() && resource.data.leadId is string && canAccessLeadId(resource.data.leadId));
      allow create: if isAdmin()
        || (isAllowed() && request.resource.data.leadId is string && canAccessLeadId(request.resource.data.leadId));
      allow update, delete: if isAdmin();
    }
    // CSV import batches, archive/restore ("Recently cleared"): admin-only
    // screens and actions in the page.
    match /importBatches/{batchId} {
      allow read, write: if isAdmin();
    }
    match /archiveOperations/{operationId} {
      allow read, write: if isAdmin();
    }
    match /archivedLeads/{leadId} {
      allow read, write: if isAdmin();
    }
    match /archivedImportBatches/{batchId} {
      allow read, write: if isAdmin();
    }
    match /appSettings/{name} {
      allow read, write: if isAllowed();
    }
    // Global do-not-contact list, keyed by the lowercased email address.
    // Anyone allowed can read it and add to it (unsubscribes are processed by
    // whoever checks replies); the doc's email must equal its lowercased id.
    // Only an admin can take an address off the list.
    match /doNotContact/{emailKey} {
      allow read: if isAllowed();
      allow create, update: if isAllowed()
        && emailKey == emailKey.lower()
        && request.resource.data.email == emailKey;
      allow delete: if isAdmin();
    }

    // Everything else (any collection the app doesn't use) is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
